# Single Google Gemini API Key
# Get your free key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Embedding & LLM Models
EMBEDDING_MODEL=gemini-embedding-001
LLM_MODEL=gemini-3.5-flash-lite

# Default PDF Document
DEFAULT_PDF_PATH=data/iPhone_16_Pro_and_iPhone_16_Pro_Max_PER_Sept2024.pdf

# Vector Store Persistence Directory
CHROMA_PERSIST_DIRECTORY=./chroma_db
COLLECTION_NAME=iphone16_rag_collection

# Voice / Audio Settings
TTS_RATE=175
TTS_VOLUME=1.0
